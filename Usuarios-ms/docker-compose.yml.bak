version: '3.8'

services:

  mysql-db:
    image: mysql:8.0
    container_name: mysql-db-usuarios
    restart: always
    environment:
      MYSQL_ROOT_PASSWORD: root_pass
      MYSQL_DATABASE: usuarios_db
      MYSQL_USER: usuarios_user
      MYSQL_PASSWORD: usuarios_pass
    ports:
      - "3310:3306"
    volumes:
      - mysql_data:/var/lib/mysql
    networks:
      - usuarios-network

volumes:
  mysql_data:
  grafana_data:

networks:
  usuarios-network:
    driver: bridge
