spring.application.name=Usuarios-ms
server.port=0
# === JPA / Hibernate ===
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=true
spring.jpa.properties.hibernate.dialect=org.hibernate.dialect.MySQL8Dialect

# === DATOS DE CONEXIoN A MYSQL (desde Docker Compose) === COMENTAMOS XQ AHORA VA EN /Service-configuration/Usuarios-ms.json

#spring.datasource.url=jdbc:mysql://localhost:3310/usuarios_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC

#spring.datasource.username=usuarios_user
#spring.datasource.password=usuarios_pass
#spring.jpa.generate-ddl=true
#spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver

# === CARGA DATOS FLYWAY
spring.flyway.enabled=true
spring.flyway.locations=classpath:db/migration
spring.flyway.baseline-on-migrate=true
spring.flyway.schemas=usuarios_db
spring.flyway.table=flyway_schema_history

# PARA VER TRAZAS MIGRACION
logging.level.org.flywaydb=DEBUG
logging.level.org.hibernate.SQL=DEBUG
logging.level.org.hibernate.type.descriptor.sql.BasicBinder=TRACE

# MONITOREO PROMETHEUS GRAFANA 
# ==============================
management.endpoints.web.exposure.include=health,info,prometheus
management.endpoint.prometheus.enabled=true
management.metrics.export.prometheus.enabled=true




# desactivamos vault
spring.cloud.vault.enabled=false
# desactivamos eureka server
spring.cloud.discovery.enabled=false
eureka.client.enabled=false